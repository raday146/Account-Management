# ---------------------------------------------------------------------------
# Backend environment template.
#
# 1. Copy this file:  cp backend/.env.example backend/.env
# 2. Replace every "your_..." placeholder with YOUR OWN local values.
#
# This repo ships NO credentials. Anyone cloning it must supply their own.
# Never commit the real .env file (it is git-ignored).
# ---------------------------------------------------------------------------

# Runtime: development | production | test
NODE_ENV=development
# Port the API listens on
PORT=3000

# PostgreSQL connection.
# When running via docker-compose, the DB container is created with the
# user/password/name below, and DB_HOST is overridden to "db" automatically.
# For running the backend directly on your machine, keep DB_HOST=localhost.
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
